---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../data/site';
import { products } from '../data/products';

const title = 'Links | Betapixel Studios, Nairobi';
const description = 'Quick links to Betapixel Studios in Nairobi: request a printing quote, chat on WhatsApp, see our work, follow us on social media and buy our colouring books.';

const glyph = {
  instagram: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.3" fill="currentColor"/></svg>',
  tiktok: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>',
  linkedin: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zm1.78 13.02H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>',
  facebook: '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.01 1.79-4.67 4.53-4.67 1.31 0 2.69.24 2.69.24v2.95h-1.51c-1.49 0-1.96.93-1.96 1.87v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>',
};

const links = [
  { id: 'quote', label: 'Request a quote', note: 'Tell us what you need and get a tailored quotation', href: '/request-a-quote/', primary: true },
  { id: 'instagram', label: 'Follow us on Instagram', note: `${site.instagramHandle} · see our latest work`, href: site.social.instagram, external: true, ig: true },
  { id: 'year-end-gifts', label: 'Year-end corporate gifts', note: 'Branded gift boxes, bottles, calendars and diaries', href: '/year-end-corporate-gifts/' },
  { id: 'uv-dtf', label: 'UV DTF magic stickers', note: 'Raised-gloss transfers for bottles, glass and metal', href: '/uv-dtf-stickers/' },
  { id: 'portfolio', label: 'See our work', note: 'Real jobs, designed, printed and installed', href: '/portfolio/' },
  { id: 'services', label: 'All services', note: 'Printing, signage, apparel, packaging and more', href: '/services/' },
  { id: 'reviews', label: 'Google reviews', note: 'Read reviews, or leave one after your order', href: site.googleBusiness, external: true },
  { id: 'directions', label: 'Directions to the studio', note: 'Kweria Rd, Nairobi', href: site.googleMapsShort, external: true },
];

const books = products.map((p) => ({ id: `book-${p.slug}`, label: p.name, note: `${p.tagline} Buy on Nuria Store`, href: p.buyUrl }));

const socials = [
  { id: 'instagram-icon', label: 'Instagram', href: site.social.instagram, svg: glyph.instagram },
  { id: 'tiktok', label: 'TikTok', href: site.social.tiktok, svg: glyph.tiktok },
  { id: 'linkedin', label: 'LinkedIn', href: site.social.linkedin, svg: glyph.linkedin },
  { id: 'facebook', label: 'Facebook', href: site.social.facebook, svg: glyph.facebook },
];
---
<BaseLayout title={title} description={description} noindex bare waContext="Link in bio">
  <section class="section links-page">
    <div class="wrap links-wrap">
      <img class="links-avatar" src="/logo-512.png" width="96" height="96" alt="Betapixel Studios logo">
      <h1 class="links-name">Betapixel Studios</h1>
      <p class="links-handle">{site.instagramHandle} · Nairobi, Kenya</p>
      <p class="links-bio">Printing &amp; branding, made in-house. Magic stickers, signage, uniforms and corporate gifts. Delivery across Kenya.</p>
      <a class="btn btn--wa btn--lg links-wa" href={whatsappUrl('Link in bio')} data-wa data-link="whatsapp" rel="noopener" target="_blank"><Icon name="whatsapp" />Chat on WhatsApp</a>
      <ul class="links-list">
        {links.map((l) => (
          <li>
            <a class:list={['links-item', l.primary && 'links-item--primary', l.ig && 'links-item--ig']} href={l.href} data-link={l.id} rel={l.external ? 'noopener' : undefined} target={l.external ? '_blank' : undefined}>
              {l.ig && <span class="links-ig-badge" set:html={glyph.instagram} />}
              <span class="links-text"><strong>{l.label}</strong><span class="links-note">{l.note}</span></span>
              <Icon name="arrow" class="icon-16" />
            </a>
          </li>
        ))}
      </ul>
      <p class="links-heading">Our books</p>
      <ul class="links-list">
        {books.map((b) => (
          <li>
            <a class="links-item" href={b.href} data-link={b.id} data-buy={b.id} rel="noopener" target="_blank">
              <span class="links-text"><strong>{b.label}</strong><span class="links-note">{b.note}</span></span>
              <Icon name="arrow" class="icon-16" />
            </a>
          </li>
        ))}
      </ul>
      <p class="links-heading">Follow us</p>
      <ul class="links-social">
        {socials.map((s) => (
          <li><a href={s.href} data-link={s.id} rel="noopener me" target="_blank" aria-label={`Betapixel Studios on ${s.label}`}><span set:html={s.svg} /></a></li>
        ))}
      </ul>
      <p class="links-call"><a href={`tel:${site.phone.e164}`} data-link="call"><Icon name="phone" class="icon-16" />{site.phone.display}</a></p>
      <p class="links-sign"><a href="/" data-link="website"><img src="/logo-512.png" width="18" height="18" alt="">betapixels.studio</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) { background: radial-gradient(120% 60% at 50% 0%, #e9eeff 0%, #f6f7fb 55%, #fff1e8 100%) fixed; }
  .links-page { padding: 48px 0 40px; min-height: 100svh; }
  .links-avatar { width: 96px; height: 96px; border-radius: 50%; background: #fff; padding: 18px; box-shadow: 0 10px 30px rgba(16, 41, 125, 0.18); margin: 0 auto 14px; display: block; }
  .links-name { font-size: 26px; margin: 0; letter-spacing: -0.01em; }
  .links-handle { margin: 4px 0 0; font-size: 15px; font-weight: 600; color: #36406b; }
  .links-bio { margin: 10px auto 22px; max-width: 34ch; font-size: 16px; line-height: 1.45; color: #36406b; }
  .links-sign { margin: 26px 0 0; }
  .links-sign a { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; color: #0b1a55; text-decoration: none; opacity: 0.8; }
  .links-sign img { width: 18px; height: 18px; }
  .links-wrap { max-width: 560px; text-align: center; }
  .links-wa { width: 100%; justify-content: center; }
  .links-list { list-style: none; padding: 0; margin: 16px 0 24px; display: grid; gap: 12px; }
  .links-item { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 20px; border: 1px solid var(--line, rgba(16, 41, 125, 0.15)); border-radius: 16px; text-align: left; text-decoration: none; color: inherit; background: var(--white, #fff); transition: transform 0.2s, box-shadow 0.2s; }
  .links-item:hover, .links-item:focus-visible { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(16, 41, 125, 0.12); }
  .links-item--primary { background: var(--orange, #ff7a2f); border-color: transparent; color: var(--navy-deep, #0b1a55); }
  .links-text { flex: 1; min-width: 0; }
  .links-note { display: block; font-size: 14px; opacity: 0.75; margin-top: 2px; }
  .links-item--ig { border-color: transparent; background: linear-gradient(#fff, #fff) padding-box, linear-gradient(45deg, #f9ce34, #ee2a7b, #6228d7) border-box; border: 2px solid transparent; }
  .links-ig-badge { width: 44px; height: 44px; flex: none; border-radius: 12px; display: grid; place-items: center; color: #fff; background: linear-gradient(45deg, #f9ce34 0%, #ee2a7b 50%, #6228d7 100%); }
  .links-ig-badge :global(svg) { width: 26px; height: 26px; }
  @keyframes links-bounce {
    0%, 76%, 100% { transform: translateY(0); }
    82% { transform: translateY(-10px); }
    88% { transform: translateY(0); }
    93% { transform: translateY(-5px); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .links-item--ig { animation: links-bounce 2.6s ease-in-out infinite; }
    .links-item--ig:hover, .links-item--ig:focus-visible { animation-play-state: paused; }
  }
  .links-wrap .links-heading { margin: 12px 0 0; font-weight: 800; font-size: 15px; letter-spacing: 0.1em; text-transform: uppercase; color: #0b1a55; opacity: 1; }
  .links-social { list-style: none; padding: 0; margin: 14px 0 18px; display: flex; justify-content: center; gap: 16px; }
  .links-social a { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--navy, #10297d); color: #fff; transition: transform 0.2s, background 0.2s; }
  .links-social a:hover, .links-social a:focus-visible { transform: translateY(-2px); background: var(--orange, #ff7a2f); }
  .links-social :global(svg) { width: 26px; height: 26px; }
  .links-call a { display: inline-flex; align-items: center; gap: 6px; }
</style>
