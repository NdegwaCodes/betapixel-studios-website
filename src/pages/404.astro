---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceRows from '../components/ServiceRows.astro';
---
<BaseLayout title="Page not found | Betapixel Studios" description="This page is not on the Betapixel Studios site. Browse our print services or go to the home page for magic stickers, branding, labels and banners." noindex>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="h1-body">That Page Is Not Here</h1>
      <p class="lead">It may have moved when we rebuilt the site. The services are listed below, or start from the <a href="/">home page</a>.</p>
      <ServiceRows />
    </div>
  </section>
</BaseLayout>
