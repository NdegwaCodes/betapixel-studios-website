---
import type { Faq } from '../lib/schema';
import { titleCase } from '../lib/titleCase';
interface Props { items: Faq[]; title?: string; id?: string }
const { items, title = 'Questions buyers ask', id = 'faq' } = Astro.props;
---
<section class="section" aria-labelledby={`${id}-title`} id={id}>
  <div class="wrap grid-2">
    <div class="sticky-col">
      <p class="eyebrow">FAQ</p>
      <h2 class="display" id={`${id}-title`} data-split>{titleCase(title)}</h2>
    </div>
    <div class="faq">
      {items.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <div class="faq__answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
