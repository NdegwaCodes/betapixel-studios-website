---
import { Picture } from 'astro:assets';
import { art, artAlt, WIDTHS } from '../lib/art';
import type { ImageMetadata } from 'astro';
import type { ArtKey } from '../data/services';
interface Props { artKey: ArtKey; photo?: ImageMetadata; alt?: string; sizes?: string; class?: string; eager?: boolean; view?: boolean }
const { artKey, photo, alt, sizes = '(min-width: 900px) 50vw, 100vw', class: cls, eager = false, view = false } = Astro.props;
---
<div class:list={['frame', 'frame--photo', cls]} data-cursor={view ? 'view' : undefined}>
  <Picture src={photo ?? art[artKey]} alt={alt ?? artAlt(artKey)} formats={['avif', 'webp']} fallbackFormat="webp" widths={WIDTHS} sizes={sizes}
    loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} fetchpriority={eager ? 'high' : undefined} />
</div>
