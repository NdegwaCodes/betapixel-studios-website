---
---
<div class="cookie" role="dialog" aria-modal="false" aria-labelledby="cookie-title" data-cookie hidden>
  <div class="cookie__body">
    <p class="cookie__title" id="cookie-title">Cookies on betapixels.studio</p>
    <p class="small">We use essential cookies to make our website work and optional cookies to understand website usage and improve your experience. <a href="/cookie-policy/">Cookie Policy</a></p>
    <div class="cookie__manage" data-cookie-manage hidden>
      <label class="choice"><input type="checkbox" checked disabled />Essential (always on)</label>
      <label class="choice"><input type="checkbox" data-cookie-cat="analytics" />Analytics: anonymous usage statistics</label>
      <label class="choice"><input type="checkbox" data-cookie-cat="marketing" />Marketing: campaign measurement (not used yet)</label>
    </div>
  </div>
  <div class="cookie__actions">
    <button class="btn btn--orange" type="button" data-cookie-accept>Accept All</button>
    <button class="btn btn--ghost" type="button" data-cookie-reject>Reject Optional</button>
    <button class="btn btn--ghost" type="button" data-cookie-toggle aria-expanded="false">Manage Cookies</button>
    <button class="btn" type="button" data-cookie-save hidden>Save choices</button>
  </div>
</div>
