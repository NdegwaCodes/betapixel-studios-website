---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import logoLight from '../assets/brand/logo-light.png';
import { services, byGroup } from '../data/services';
import { products } from '../data/products';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const cur = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined);
const primary = [
  { href: '/about/', label: 'About' },
  { href: '/uv-dtf-stickers/', label: 'UV DTF Stickers' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/knowledge-centre/', label: 'Knowledge Centre' },
  { href: '/contact/', label: 'Contact' },
];
const flagship = services[0];
const print = byGroup('print').filter((s) => s.slug !== flagship.slug);
const brand = byGroup('brand');
const publishing = byGroup('publishing');
---
<header class:list={['site-header', overlay && 'is-over-hero']} data-header data-overlay={overlay ? '' : undefined}>
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="Betapixel Studios, home">
      <Image class="logo-dark" src={logo} alt="Betapixel Studios logo" width={200} densities={[1, 2]} loading="eager" />
      <Image class="logo-light" src={logoLight} alt="Betapixel Studios logo" width={200} densities={[1, 2]} loading="eager" />
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        <li><a class="ul-link" href={primary[0].href} aria-current={cur(primary[0].href)}>{primary[0].label}</a></li>
        <li class="nav__services">
          <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mega-menu">Products &amp; Services</button>
          <div class="mega" id="mega-menu">
            <div class="mega__inner">
              <a class="mega__flagship" href={`/${flagship.slug}/`} aria-current={cur(`/${flagship.slug}/`)}>
                <span class="mega__badge">Flagship</span>
                <span class="mega__flag-name">{flagship.name}</span>
                <span class="mega__flag-sub">{flagship.menu}</span>
                <span class="mega__flag-cta">Explore UV DTF →</span>
              </a>
              <div class="mega__col">
                <p class="mega__label">Print &amp; Production</p>
                <ul>{print.map((s) => <li><a href={`/${s.slug}/`} aria-current={cur(`/${s.slug}/`)}><strong>{s.name}</strong><span>{s.menu}</span></a></li>)}</ul>
              </div>
              <div class="mega__col">
                <p class="mega__label">Brand Solutions</p>
                <ul>{brand.map((s) => <li><a href={`/${s.slug}/`} aria-current={cur(`/${s.slug}/`)}><strong>{s.name}</strong><span>{s.menu}</span></a></li>)}</ul>
                <p class="mega__label" style="margin-top:18px">Publishing &amp; Betapixel Products</p>
                <ul>
                  {publishing.map((s) => <li><a href={`/${s.slug}/`} aria-current={cur(`/${s.slug}/`)}><strong>{s.name}</strong><span>{s.menu}</span></a></li>)}
                  <li><a href="/products/" aria-current={cur('/products/')}><strong>Betapixel Products</strong><span>{products.length} original colouring books</span></a></li>
                </ul>
              </div>
            </div>
            <a class="mega__all" href="/services/">View all Products &amp; Services →</a>
          </div>
        </li>
        {primary.slice(1).map((l) => <li><a class="ul-link" href={l.href} aria-current={cur(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="btn btn--orange header-cta" href="/request-a-quote/">Request a Quote</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav"><span class="menu-btn__icon" aria-hidden="true"></span><span>Menu</span></button>
    </div>
  </div>
</header>
<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="/about/" aria-current={cur('/about/')}>About</a></li>
    <li>
      <details class="mobile-nav__group">
        <summary>Products &amp; Services</summary>
        <ul>
          {services.map((s) => <li><a href={`/${s.slug}/`} aria-current={cur(`/${s.slug}/`)}>{s.name}</a></li>)}
          <li><a href="/products/" aria-current={cur('/products/')}>Betapixel Products</a></li>
          <li><a href="/services/">View all →</a></li>
        </ul>
      </details>
    </li>
    {primary.slice(1).map((l) => <li><a href={l.href} aria-current={cur(l.href)}>{l.label}</a></li>)}
    <li><a href="/faq/" aria-current={cur('/faq/')}>FAQ</a></li>
  </ul>
  <a class="btn btn--orange" href="/request-a-quote/">Request a Quote</a>
</nav>
